---
import Base from "../layouts/Base.astro";
import { site, home, services, team, newPatients } from "../data/site";
const o = home.openings;
---

<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">{site.tagline}</p>
        <h1>{home.title}</h1>
        <p class="lede">{home.text}</p>
        <div class="cta">
          <a class="btn btn-primary" href="/appointment">Request an appointment</a>
          <a class="btn btn-line" href="/new-patients">New patient information</a>
        </div>
      </div>
      <aside class="openings" aria-labelledby="open-h">
        <div class="o-head">
          <h2 id="open-h">Next openings</h2>
          <p class="muted">{o.note}</p>
        </div>
        <ul>
          {o.days.map((d) => (
            <li>
              <p class="day"><span>{d.day}</span><span class="muted">{d.date}</span></p>
              <div class="slots">{d.slots.map((s) => <span class="slot">{s}</span>)}</div>
            </li>
          ))}
        </ul>
        <div class="o-foot">
          <p class="muted">New patients: first visit about 90 minutes</p>
          <a class="btn btn-primary btn-sm" href={site.bookingUrl || "/appointment"}>Request a time</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="reasons">
    <div class="wrap r-grid">
      {home.reasons.map((r) => <div><h3>{r.title}</h3><p>{r.text}</p></div>)}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head-row">
        <h2>What we do</h2>
        <a href="/services">All services</a>
      </div>
      <ul class="svc">
        {services.slice(0, 6).map((s) => (
          <li>
            <a href={`/services#${s.id}`}>{s.name}</a>
            <p>{s.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section plan-band">
    <div class="wrap plan">
      <div>
        <h2>No dental insurance?</h2>
        <p class="lede">{newPatients.plan.text}</p>
        <a href="/new-patients#plan">How the plan works</a>
      </div>
      <p class="price">{newPatients.plan.price}<span class="muted">{newPatients.plan.name}</span></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap team">
      <div>
        <h2>The people you'll see</h2>
        <p class="lede">Two dentists, two hygienists and a front desk that will call your insurance for you.</p>
        <a class="btn btn-line" href="/team">Meet the team</a>
      </div>
      <ul>
        {team.map((m) => <li><span>{m.name}</span><span class="muted">{m.role}</span></li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(40px, 6vw, 80px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(320px, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .kicker {
    color: var(--muted);
    margin-bottom: 20px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .openings {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 8px 24px rgba(15, 61, 62, 0.06);
  }
  .o-head h2 {
    font-size: 1.375rem;
    font-weight: 500;
    margin-bottom: 4px;
  }
  .o-head .muted {
    margin: 0 0 16px;
  }
  .openings ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .openings li {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 12px;
    align-items: center;
    padding-block: 12px;
    border-top: 1px solid var(--line);
  }
  .day {
    margin: 0;
    display: grid;
    line-height: 1.3;
  }
  .day span:first-child {
    font-weight: 500;
  }
  .slots {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .o-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .o-foot .muted {
    margin: 0;
  }
  .reasons {
    background: var(--mint);
  }
  .r-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    padding-block: 40px;
  }
  .r-grid h3 {
    margin-bottom: 4px;
  }
  .r-grid p {
    margin: 0;
    color: var(--ink-2);
  }
  .head-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }
  .svc {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 32px;
  }
  .svc li {
    padding-block: 20px;
    border-top: 1px solid var(--line);
  }
  .svc a {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }
  .svc a:hover {
    text-decoration: underline;
  }
  .svc p {
    margin: 4px 0 0;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .plan-band {
    padding-block: 0;
  }
  .plan {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) auto;
    gap: 32px;
    align-items: center;
    padding: clamp(24px, 4vw, 48px);
    background: var(--ink);
    color: #eef6f5;
    border-radius: 20px;
  }
  .plan .lede {
    color: #bcd2d0;
  }
  .plan a {
    color: #fff;
  }
  .plan :focus-visible {
    outline-color: #fff;
  }
  .price {
    display: grid;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
    margin: 0;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .price .muted {
    color: #bcd2d0;
  }
  .team {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .team ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .team li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-block: 14px;
    border-top: 1px solid var(--line);
  }
  .team li .muted {
    margin: 0;
  }
  @media (max-width: 900px) {
    .hero-grid,
    .team,
    .plan {
      grid-template-columns: 1fr;
    }
    .price {
      text-align: left;
    }
    .r-grid,
    .svc {
      grid-template-columns: 1fr;
    }
    .r-grid {
      gap: 20px;
    }
  }
  @media (max-width: 420px) {
    .openings li {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .day {
      display: flex;
      gap: 8px;
    }
  }
</style>
