---
import Base from "../layouts/Base.astro";
import { site, services } from "../data/site";
---

<Base title="Services" description="Cleanings, fillings, crowns, whitening, clear aligners, emergency care, children's dentistry and gum care.">
  <header class="page-head">
    <div class="wrap">
      <h1>Dental services</h1>
      <p class="lede">Everything we do in the office, and what each visit is like. Not sure what you need? Describe it in the appointment form and we'll book the right time.</p>
      <nav class="jump" aria-label="Services on this page">
        {services.map((s) => <a href={`#${s.id}`}>{s.name}</a>)}
      </nav>
    </div>
  </header>
  <section class="section">
    <div class="wrap">
      {
        services.map((s) => (
          <article id={s.id}>
            <div>
              <h2>{s.name}</h2>
              <p>{s.summary}</p>
            </div>
            <div class="expect">
              <h3>What to expect</h3>
              <ul>{s.expect.map((x) => <li>{x}</li>)}</ul>
            </div>
          </article>
        ))
      }
      <div class="end">
        <a class="btn btn-primary" href="/appointment">Request an appointment</a>
        <a class="btn btn-line" href={`tel:${site.emergencyPhone.replace(/[^\d+]/g, "")}`}>Emergency line {site.emergencyPhone}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }
  .jump a {
    padding: 6px 12px;
    border-radius: 8px;
    background: var(--mint);
    color: var(--ink);
    text-decoration: none;
    font-size: 0.875rem;
    transition: background-color 160ms var(--ease);
  }
  .jump a:hover {
    background: #d6e8e5;
  }
  article {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 72px);
    padding-block: 32px;
    border-top: 1px solid var(--line);
    scroll-margin-top: 24px;
  }
  article h2 {
    font-size: 1.75rem;
  }
  article p {
    color: var(--ink-2);
    font-size: 1.0625rem;
  }
  .expect {
    padding: 20px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
  }
  .expect h3 {
    font-size: 1rem;
    margin-bottom: 8px;
  }
  .expect ul {
    margin: 0;
    padding-left: 20px;
    color: var(--ink-2);
  }
  .expect li + li {
    margin-top: 4px;
  }
  .end {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  @media (max-width: 760px) {
    article {
      grid-template-columns: 1fr;
    }
  }
</style>
