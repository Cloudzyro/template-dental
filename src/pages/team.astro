---
import Base from "../layouts/Base.astro";
import { team } from "../data/site";
const groups = [...new Set(team.map((m) => m.group))];
const initials = (n: string) => n.replace(/^Dr\.\s/, "").split(/[\s,]+/).slice(0, 2).map((p) => p[0]).join("");
---

<Base title="Our team" description="The dentists, hygienists and front desk team at Linden Family Dental.">
  <header class="page-head">
    <div class="wrap">
      <h1>Our team</h1>
      <p class="lede">Small enough that you'll see the same faces every visit.</p>
    </div>
  </header>
  <section class="section">
    <div class="wrap">
      {
        groups.map((g) => (
          <section class="group" aria-labelledby={`g-${g}`}>
            <h2 id={`g-${g}`}>{g}</h2>
            <ul>
              {team.filter((m) => m.group === g).map((m) => (
                <li>
                  <svg viewBox="0 0 96 96" width="96" height="96" role="img" aria-label={`Portrait placeholder for ${m.name}`}>
                    <rect width="96" height="96" rx="16" fill="#e6f1ef"></rect>
                    <text x="48" y="56" text-anchor="middle" font-family="Lexend Variable, sans-serif" font-size="26" fill="#0f3d3e">{initials(m.name)}</text>
                  </svg>
                  <div>
                    <h3>{m.name}</h3>
                    <p class="muted">{m.role}</p>
                    <p>{m.bio}</p>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .group + .group {
    margin-top: 48px;
  }
  .group h2 {
    font-size: 1.5rem;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line-strong);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 40px;
  }
  li {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 20px;
    padding-top: 16px;
  }
  h3 {
    margin-bottom: 0;
  }
  li .muted {
    margin: 0 0 8px;
  }
  li p:not(.muted) {
    color: var(--ink-2);
    margin: 0;
  }
  @media (max-width: 760px) {
    ul {
      grid-template-columns: 1fr;
    }
  }
</style>
